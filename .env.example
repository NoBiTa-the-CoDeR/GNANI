GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=gNaniAI/1.0 (replace with your contact email)
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
GOOGLE_MAPS_API_KEY=
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
LLM_PROVIDERS=groq,openrouter
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_BASE_URL=https://api.groq.com/openai/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_KN=Saanvi
GNANI_TTS_VOICE_MIXED=Poorvi
GNANI_TTS_VOICE_V3=Shivani

PIXABAY_API_KEY=
YOUTUBE_API_KEY=
YT_DAILY_SEARCH_LIMIT=90
# Embed key must be restricted to the website HTTP referrer in Google Cloud.
GOOGLE_MAPS_EMBED_KEY=

JAMENDO_CLIENT_ID=
GNANI_TTS_SPEED=.93
GNANI_TTS_SPEED_EN=.93
GNANI_TTS_SPEED_HI=.93
GNANI_TTS_SPEED_KN=.93

# Optional camera reading, using the existing backend Groq key.
VISION_MODEL=qwen/qwen3.8-27b

# Experimental web helper is off in every new browser until the user opts in.
WEB_GROQ_MODEL=
WEB_OPENROUTER_MODEL=openrouter/free
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: WEB_CHROMIUM_EXECUTABLE=/absolute/path/to/test-chromium

WEB_GEMINI_MODEL=gemini-3.1-flash-lite
